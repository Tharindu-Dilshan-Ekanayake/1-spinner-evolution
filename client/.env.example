# >>> FILL ME IN <<<
# The game slug from your Boxity developer dashboard.
# Copy this file to `.env` (or `.env.local`) and replace the placeholder.
VITE_GAME_SLUG=MY_GAME_SLUG

# The game's Boxity hosting id (hosting.bloxity.io), once the server runs on Boxity
# hosting. With it, every connect goes through Boxity's matchmaker; without it (local
# dev, or a server hosted elsewhere) the client connects to VITE_SERVER_URL / its own
# origin. It is an id, not an address.
# VITE_BLOXITY_HOSTING_ID=

# Boxity's addresses are never configured here: the platform tells the game which
# environment it is in (see src/bloxity/environment.js). The Vite dev server tells it
# "local" (vite.config.js).

# The Colyseus game server when NOT hosted on Boxity. Leave unset in dev (it uses this
# host on port 3000) and when the server also serves the built client (same origin).
# VITE_SERVER_URL=https://game.example.com
